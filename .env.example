# --- Database -------------------------------------------------------------
# Render Postgres. Trong cùng region dùng Internal Database URL (nhanh hơn,
# không cần SSL). Kết nối từ máy cá nhân thì dùng External URL + DATABASE_SSL=true.
DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_SSL=false

# --- Bảo mật --------------------------------------------------------------
# Sinh bằng: openssl rand -hex 32
LINK_SIGNING_SECRET=
# Sinh bằng: openssl rand -hex 16   — dùng để băm IP, KHÔNG lưu IP thô
IP_SALT=
# Bearer token cho /api/mcp. Agent phải gửi: Authorization: Bearer <token>
MCP_API_TOKEN=

# --- Ứng dụng -------------------------------------------------------------
# Địa chỉ công khai, dùng để dựng URL trả về cho agent. Không có dấu / ở cuối.
PUBLIC_BASE_URL=http://localhost:3000
# Hạn chữ ký, tính bằng giây. Mặc định 30 ngày.
# Muốn bám đúng spec gốc (10 phút) thì đặt 600.
SIGNATURE_TTL=2592000
# Thời gian chờ mặc định trên trang bọc (ms) khi agent không truyền time_wait.
DEFAULT_TIME_WAIT=3000

# --- Tuỳ chọn -------------------------------------------------------------
# Google Analytics 4. Để trống thì trang không nhúng script nào.
# Điền sau chỉ cần restart, KHÔNG phải build lại (xem CONTEXT.md mục 3.8).
GA4_ID=
# Danh sách host đích được phép, phân tách bằng dấu phẩy. Để trống = cho phép mọi
# host public. Ví dụ: projecta.com,www.projecta.com
ALLOWED_DESTINATION_HOSTS=
